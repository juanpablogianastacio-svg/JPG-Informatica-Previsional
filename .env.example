# Conexión a Postgres (docker compose local por defecto)
DATABASE_URL=postgres://jpg:jpg@localhost:5432/jpg_previsional
# Puerto de la API (Vite proxea /api a este puerto en desarrollo)
PORT=3001
# Cuenta inicial que se crea si no existe ningún usuario
ADMIN_EMAIL=admin@estudio.local
ADMIN_PASSWORD=cambiar-esta-clave
ADMIN_NOMBRE=Equipo del estudio
# Carpeta de adjuntos (en Railway, montar un Volume y apuntar acá)
UPLOAD_DIR=./uploads
# true si la base requiere SSL (Railway externo); con la URL interna no hace falta
PGSSL=false
