{
  "name": "jpg-informatica-previsional",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "JPG Informática Previsional — sistema de gestión previsional para estudio jurídico (Santa Fe Capital)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "migrate": "node server/db/migrate.js",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "test": "node --test server/lib/calc.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.0",
    "vite": "^7.0.0"
  }
}
